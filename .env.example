# Generate with: python -c "import secrets; print(secrets.token_urlsafe(36))"
# Do not use the example values below; create your own strong random secrets.
AGENTFLOW_DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
AGENTFLOW_TOKEN=REPLACE_WITH_32_PLUS_CHAR_RANDOM_BEARER_TOKEN

# Optional v1.0.0 operator-only audit signing. Keep a random key outside source control.
# AGENTFLOW_AUDIT_HMAC_KEY=REPLACE_WITH_A_HIGH_ENTROPY_32_PLUS_BYTE_KEY
# Optional Fernet vault: generate with cryptography. Keep master key outside vault directory.
# AGENTFLOW_VAULT_KEY=EXTERNAL_FERNET_KEY_NOT_STORED_IN_REPOSITORY
